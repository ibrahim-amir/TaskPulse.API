<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mvc.Testing is what boots the real API in memory so tests can send it
         actual HTTP requests. Its version tracks the API's ASP.NET Core one. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskPulse.API\TaskPulse.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saves a "using Xunit;" at the top of every test file. -->
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
